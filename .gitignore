# Dependencies (wendkeep is zero-dependency; this is only for local tooling)
node_modules/

# Logs / OS cruft
*.log
npm-debug.log*
.DS_Store
Thumbs.db

# Test / build artifacts
coverage/
*.tgz
.tmp/
tmp/
.worktrees/

# Local Obsidian vaults created by `wendkeep init` and the test suite
.*-vault/

# Stray scrape data from another project — NOT part of wendkeep
.firecrawl/

# Editors
.vscode/
.idea/

# Backups que o `wendkeep init` cria ao mesclar config (settings.json, .mcp.json).
# Sao artefatos locais de cada execucao — nunca versionados.
*.bak
