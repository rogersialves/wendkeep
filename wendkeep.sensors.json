{
  "$schema": "https://raw.githubusercontent.com/rogersialves/wendkeep/main/schema/wendkeep.sensors.schema.json",
  "version": 1,
  "source": "manual",
  "sensors": [
    {
      "id": "tests",
      "name": "Tests",
      "description": "node --test (the full suite)",
      "severity": "critical",
      "command": "npm test"
    },
    {
      "id": "check",
      "name": "Syntax check",
      "description": "node --check on the entrypoints",
      "severity": "critical",
      "command": "npm run check"
    },
    {
      "id": "release-tests",
      "name": "release-tests",
      "description": "node --test tests/release-changelog.test.mjs",
      "severity": "critical",
      "type": "command",
      "command": "node --test tests/release-changelog.test.mjs"
    },
    {
      "id": "memory-health",
      "name": "Shared memory health",
      "description": "Blocks delivery only on memory corruption, projection lag or active conflict",
      "severity": "critical",
      "type": "command",
      "command": "node bin/wendkeep.mjs memory status --gate --vault .WendKeep-vault"
    },
    {
      "id": "docs-bilingual",
      "name": "Bilingual command documentation",
      "description": "Checks mirrored PT-BR/EN guides, public command coverage, navigation, governance and tarball contents",
      "severity": "critical",
      "type": "command",
      "command": "node --test tests/docs-bilingual.test.mjs tests/readme-packaging.test.mjs"
    },
    {
      "id": "session-memory-lifecycle",
      "name": "Session memory lifecycle",
      "description": "Exercises the full legacy-to-v2 SessionStop lifecycle, causal retries and memory diagnostics",
      "severity": "critical",
      "type": "command",
      "command": "node --test tests/session-stop-migration-lifecycle.test.mjs tests/memory-activation.test.mjs tests/session-memory-lifecycle.test.mjs tests/vault-health-memory.test.mjs"
    }
  ]
}
