{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wendkeep.dev/schema/migration-receipt-v1.schema.json",
  "title": "WendKeep migration receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "resource",
    "status",
    "from_version",
    "to_version",
    "before_sha256",
    "after_sha256",
    "backup_sha256",
    "backup_file",
    "steps"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "resource": {
      "enum": ["vault", "ledger", "active-contexts", "observer", "portable"]
    },
    "status": { "enum": ["completed", "rolled_back"] },
    "from_version": { "type": "integer", "minimum": 0 },
    "to_version": { "type": "integer", "minimum": 0 },
    "before_sha256": { "$ref": "#/$defs/sha256" },
    "after_sha256": { "$ref": "#/$defs/sha256" },
    "backup_sha256": { "$ref": "#/$defs/sha256" },
    "backup_file": { "const": "migration-source.backup.json" },
    "restored_sha256": { "$ref": "#/$defs/sha256" },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "from_version", "to_version", "before_sha256", "after_sha256"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "from_version": { "type": "integer", "minimum": 0 },
          "to_version": { "type": "integer", "minimum": 1 },
          "before_sha256": { "$ref": "#/$defs/sha256" },
          "after_sha256": { "$ref": "#/$defs/sha256" }
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
